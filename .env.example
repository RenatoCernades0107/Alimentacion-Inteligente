# Supabase (local: `npx supabase status`; producción: Project Settings › API)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Notificaciones push (se generan con: node scripts/setup-env.mjs)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# Protege /api/cron/daily (Vercel Cron envía "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=

# IA vía InferHub (API compatible con OpenAI). Los ids de modelo salen de: GET https://api.inferhub.dev/v1/models
INFERHUB_API_KEY=
# INFERHUB_BASE_URL=https://api.inferhub.dev/v1
# Reconocer alimentos en fotos y boletas (necesita un modelo con visión)
INFERHUB_VISION_MODEL=
# Chef IA (planificador conversacional); sin llave, el Chef arma un plan base sin IA.
INFERHUB_CHAT_MODEL=
# Fotos de platos generadas para recetas sin foto (opcional; sin modelo las recetas siguen con emoji).
INFERHUB_IMAGE_MODEL=
