# Supabase (local: `npx supabase status`; producción: Project Settings › API)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Notificaciones push (se generan con: node scripts/setup-env.mjs)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# Protege /api/cron/daily (Vercel Cron envía "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=

# Reconocer alimentos en fotos y boletas (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview
